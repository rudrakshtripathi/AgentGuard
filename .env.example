# AgentGuard configuration. Copy to .env and fill in:  cp .env.example .env
# `npm run setup` does this for you and generates random secrets.
# Every variable below is read by the code under exactly this name.

# ---------------------------------------------------------------- Database
# Application role (least privilege; created by `npm run db:migrate` from this URL's
# username/password). It has NO UPDATE/DELETE on audit_log.
DATABASE_URL=postgres://agentguard_app:CHANGE_ME_APP_DB_PASSWORD@127.0.0.1:54329/agentguard
# Owner role: migrations, seeding, and the controlled tamper demo only. Never used by the server.
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:54329/agentguard
# Supabase: use the *session-mode* connection strings (port 5432), not the transaction pooler
# (port 6543) — live updates need LISTEN. Example:
#   DATABASE_ADMIN_URL=postgres://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   DATABASE_URL=postgres://agentguard_app.<project-ref>:<app-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Embedded local Postgres (`npm run db:start`) — only used if you run Postgres that way.
EMBEDDED_PG_PORT=54329
EMBEDDED_PG_USER=postgres
EMBEDDED_PG_PASSWORD=postgres

# ---------------------------------------------------------------- Demo credentials (seeded)
# Admin dashboard login. Stored as a bcrypt hash in `admins`; never commit a real value.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# API key for the demo agent (stored as a SHA-256 hash in `agents`). Format: ag_<random>.
DEMO_AGENT_API_KEY=ag_CHANGE_ME_GENERATE_WITH_npm_run_setup

# ---------------------------------------------------------------- Policy engine (OPA)
# Internal-only sidecar; `npm run opa:start` binds it to 127.0.0.1.
OPA_URL=http://127.0.0.1:8181
OPA_TIMEOUT_MS=1500

# ---------------------------------------------------------------- API server
API_HOST=127.0.0.1
API_PORT=4000
# Used by the dashboard (Next.js rewrites /api/* here; read at build/start time).
API_URL=http://127.0.0.1:4000
SESSION_TTL_HOURS=8
# Set true when serving the dashboard over HTTPS.
COOKIE_SECURE=false
LOG_LEVEL=info

# ---------------------------------------------------------------- Risk / approval tuning
APPROVAL_TIMEOUT_SECONDS=120
APPROVAL_POLL_INTERVAL_MS=1000
# "Unusual hour" = outside [START, END) in BUSINESS_TIMEZONE (IANA name). Defaults to the
# server's timezone if unset.
BUSINESS_HOURS_START=7
BUSINESS_HOURS_END=21
# BUSINESS_TIMEZONE=Asia/Kolkata
INTERNAL_EMAIL_DOMAINS=acme.example
AGENT_RATE_LIMIT_PER_MINUTE=120
# INJECTION_MODEL_PATH=apps/api/models/injection-model.json

# ---------------------------------------------------------------- Demo agent (optional)
# Only needed for the live, unscripted agent run (`npm run agent -- "<task>"`).
# Canned scenarios on /demo never call the LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AGENTGUARD_URL=http://127.0.0.1:4000
