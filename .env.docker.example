# Copy to .env before running Docker Compose. Replace every CHANGE_ME value.
POSTGRES_USER=agentguard_admin
POSTGRES_PASSWORD=CHANGE_ME_ADMIN_DB_PASSWORD
APP_DB_USER=agentguard_app
APP_DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_DASHBOARD_PASSWORD
DEMO_AGENT_API_KEY=CHANGE_ME_AGENT_API_KEY
INTERNAL_EMAIL_DOMAINS=acme.example
API_PORT=4000
DASHBOARD_PORT=3000
